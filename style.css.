
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: #080b14;
  color: white;
  font-family: Arial, sans-serif;
  padding: 20px;
}

.header {
  text-align: center;
  padding: 25px 10px;
}

.header h1 {
  color: #00eaff;
  font-size: 27px;
  text-shadow: 0 0 15px #00eaff;
}

.header p {
  color: #8995aa;
  margin-top: 8px;
}

.panel {
  background: #111a2b;
  border: 1px solid #183e58;
  border-radius: 16px;
  padding: 20px;
  margin-bottom: 18px;
}

.panel h2 {
  color: #00eaff;
  font-size: 18px;
  margin-bottom: 18px;
}

.control {
  margin: 20px 0;
}

.control label {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12px;
}

input[type="range"] {
  width: 100%;
  accent-color: #00eaff;
}

button {
  width: 100%;
  padding: 15px;
  background: linear-gradient(90deg,#007bff,#00eaff);
  border: none;
  border-radius: 12px;
  color: #00111c;
  font-size: 16px;
  font-weight: bold;
}

.status {
  color: #00ff9d;
  text-align: center;
  margin-top: 15px;
}
